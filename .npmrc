# Next's `output: standalone` traces dependencies by walking real paths. pnpm's
# default symlinked store hides transitive deps (notably @swc/helpers, which next
# requires at runtime) from that trace, producing a standalone bundle that builds
# fine and then dies with MODULE_NOT_FOUND on first boot.
#
# A hoisted layout lays node_modules out flat, the way the tracer expects.
node-linker=hoisted
